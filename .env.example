# Konfiguracja powiadomień Telegram (MVP: Alerty 8.0+)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Konfiguracja Notion (warstwa operacyjna obecnego demo)
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# Ścieżki i lokalne usługi
JOB_SCOUT_DATABASE_PATH="data/job_scout.db"
LOCAL_LLM_BASE_URL="http://127.0.0.1:8000/v1"
LOCAL_LLM_MODEL="DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf"
LOCAL_LLM_MODEL_PATH="models/DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf"
LOCAL_LLM_CONTEXT_SIZE="4096"
LOCAL_LLM_REASONING="true"
# Puste = bez sztucznego limitu reasoning; zostaje watchdog procesu.
LOCAL_LLM_REASONING_BUDGET=""
# Watchdog pojedynczego etapu oferty; to nie jest limit tokenów modelu.
LOCAL_LLM_STAGE_TIMEOUT_SECONDS="1800"
SCOUT_LLM_MODEL="Qwen3.5-9B-Q4_K_M.gguf"
SCOUT_LLM_MODEL_PATH="models/Qwen3.5-9B-Q4_K_M.gguf"
# Polski prowadzący wywiad Career Knowledge Base. Aplikacja uruchamia go na żądanie.
CAREER_LLM_MODEL="Bielik-11B-v3.0-Instruct.Q4_K_M.gguf"
CAREER_LLM_MODEL_PATH="models/Bielik-11B-v3.0-Instruct.Q4_K_M.gguf"
CAREER_LLM_BASE_URL="http://127.0.0.1:8001/v1"
CAREER_LLM_CONTEXT_SIZE="8192"
CAREER_LLM_STARTUP_TIMEOUT_SECONDS="120"
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LLAMA_SERVER_EXECUTABLE="llama-server"
MLFLOW_TRACKING_URI="file:./data/mlruns"
